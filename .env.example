# Public: safe to expose in the built frontend (just the project URL).
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co

# --- The following are never read by the frontend. They exist only for the
# local tooling below (supabase CLI secrets push, home-PC sync script). ---

# Supabase project ref, e.g. xxxxxxxx (from the project URL / dashboard).
SUPABASE_PROJECT_REF=

# Capture Token: lets a device submit new items and read today's philosophy
# question. Put in the mobile/work setup URL fragment, never committed.
SAGE_CAPTURE_TOKEN=

# Sync Token: lets the home PC list unsynced items and acknowledge them.
# Stored only on the home PC and as a Supabase function secret.
SAGE_SYNC_TOKEN=
